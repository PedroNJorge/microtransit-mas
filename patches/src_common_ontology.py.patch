+@concept
+@dataclass
+class PoolSnapshot:
+    """One pending pool as a hub replicates it to its peers (enough for a neighbour to carry it on)."""
+    pool_id: str
+    request: TripRequest
+    rider_jid: str
+    state: str                          # PROPOSED | AWAITING_ESCROW | AUCTIONING
+    escrows: Dict[str, str] = field(default_factory=dict)     # request_id -> escrow_id (informational)
+    created_at: float = 0.0
+
+
+@concept
+@dataclass
+class HubSnapshot:
+    """Hub -> every peer (InterHubCoordinationProtocol, inform): the hub's pending pools. Sent on every
+    change and at least every T_hub_sync, so it is also the heartbeat: a hub whose snapshots stop is
+    presumed dead."""
+    hub_id: str
+    seq: int                            # grows by one per snapshot
+    sent_at: float
+    load: int                           # live pools (pending + assigned)
+    capacity: int
+    pools: List[PoolSnapshot] = field(default_factory=list)
+
+
+@concept
+@dataclass
+class HubTakeover:
+    """New hub -> rider (InterHubCoordinationProtocol, inform): "I serve your request from now on".
+    The rider only believes it if `old_hub` is its current hub and `new_hub` is a hub it knows."""
+    request_id: str
+    pool_id: str
+    old_hub: str                        # JID
+    new_hub: str                        # JID (also the sender)
+    reason: FailureReason               # HUB_FAILED (failover) or OVERLOADED (overflow)
+
+
+@concept
+@dataclass
+class EscrowRebind:
+    """Rider -> Payment (EscrowRebindProtocol, request): move my HELD escrow(s) of this pool from the hub
+    that failed to its successor. Only the rider who owns the money may ask."""
+    rider_id: str
+    pool_id: str
+    old_hub: str                        # JID
+    new_hub: str                        # JID
+
+
