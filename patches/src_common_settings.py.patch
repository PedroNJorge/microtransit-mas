+# ---- Inter-hub coordination (protocols/inter_hub.py) -------------------------------------------
+# Failover budget. A hub's snapshots are its heartbeat: peers declare it failed after T_HUB_TIMEOUT
+# of silence and its successor takes over at once, so the pick-up happens roughly T_HUB_TIMEOUT
+# after the crash. InterHubRules checks T_HUB_SYNC < T_HUB_TIMEOUT < T_FAILOVER.
+T_FAILOVER = 60.0               # the neighbour has picked up the pending requests within this
+T_HUB_SYNC = 10.0               # a hub sends its snapshot at least this often (and on every change)
+T_HUB_TIMEOUT = 25.0            # silence after which a peer is presumed dead (2.5 missed syncs)
+T_FORECAST = 60.0               # a hub publishes its demand forecast this often
+FORECAST_WINDOW = 600.0         # the arrival rate is measured over this much past...
+FORECAST_HORIZON = 900.0        # ...and extrapolated over this much future
+T_OVERFLOW = 30.0               # how long the overloaded hub waits for a neighbour's answer
+AUCTION_GRACE = T_PROVISIONAL   # an adopted pool waits this long before its first CFP: the dead hub's
